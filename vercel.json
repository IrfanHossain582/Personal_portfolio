{
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/robots.txt", "dest": "/robots.txt" },
    { "src": "/api/contact", "dest": "/api/contact.php" },
    { "src": "/irfan-manage", "dest": "/api/admin/login.php" },
    { "src": "/admin/logout", "dest": "/api/admin/logout.php" },
    { "src": "/admin/dashboard", "dest": "/api/admin/dashboard.php" },
    { "src": "/admin/profile", "dest": "/api/admin/profile.php" },
    { "src": "/admin/skills", "dest": "/api/admin/skills.php" },
    { "src": "/admin/projects", "dest": "/api/admin/projects.php" },
    { "src": "/admin/education", "dest": "/api/admin/education.php" },
    { "src": "/admin/experience", "dest": "/api/admin/experience.php" },
    { "src": "/admin/achievements", "dest": "/api/admin/achievements.php" },
    { "src": "/admin/messages", "dest": "/api/admin/messages.php" },
    { "src": "/privacy", "dest": "/api/privacy.php" },
    { "src": "/terms", "dest": "/api/terms.php" },
    { "src": "/api/admin/(.*)", "dest": "/api/index.php" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}