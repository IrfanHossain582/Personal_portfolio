{
  "functions": {
    "**/*.php": {
      "runtime": "vercel-php@0.6.0",
      "includeFiles": "config/**, admin/**, assets/**, api/**"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/admin/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.php"
    }
  ]
}
